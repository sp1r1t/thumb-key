    <string name="hide_labels_info">Eine Kategorie zu verstecken entfernt nur Beschriftungen und Icons. Die Tasten selbst funktionieren weiter.</string>
    <string name="hide_key_groups">Gruppen der Verstecken-Taste</string>
    <string name="hide_key_groups_summary">Die Verstecken-Taste schaltet derzeit %1$s um</string>
